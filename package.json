{
	"name": "sajilo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"test": "turbo run test"
	},
	"devDependencies": {
		"prettier": "^3.7.4",
		"turbo": "^2.6.3",
		"typescript": "5.9.2",
		"vitest": "^5.0.4"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=20"
	},
	"pnpm": {
		"overrides": {
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0"
		}
	},
	"description": "Sajilo - offline-first PWA for daily savings collection and lending, built for a bank collector in Nepal"
}
