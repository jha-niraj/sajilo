# ─── Database (Neon) ───
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ───
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL=http://localhost:3000
AUTH_COOKIE_PREFIX=sajilo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MAIN_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# ─── Doc AI: photo -> text (Sarvam) ───
SARVAM_API_KEY=

# ─── AI: text -> rows (optional; without it, customer lists use a simple line reader) ───
OPENAI_API_KEY=

# ─── Cloudflare R2 (optional; keeps scanned photos) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sajilo-uploads
R2_PUBLIC_URL=

# ─── Email (optional) ───
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sajilo <noreply@example.com>"
