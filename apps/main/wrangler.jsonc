{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sajilo",
	// worker.ts wraps OpenNext's handler so sign-out is answered before the Next bundle loads.
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": true,

	// Pinned next to Neon (ap-southeast-1): every query is its own HTTPS request, so the Worker runs
	// beside the database. A response header `Cf-Placement` names where it ran. Repeat this under any
	// env.* block added later; it is not inherited.
	"placement": { "region": "aws:ap-southeast-1" },

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Only what is not in .env.production. Everything in .env.production (DATABASE_URL, auth, Sarvam,
	// OpenAI, Resend, the site URLs, R2 keys) goes up as Worker secrets with `pnpm deploy`
	// (--secrets-file) or `pnpm secrets`. A key must not be in both places.
	"vars": {
		"ADMIN_APP_URL": "https://admin.sajilo.example.com"
	},

	// Same as Gurukul and the Cloudflare dashboard: logs and traces kept, every request sampled.
	// Leaving this out would switch them off again on the next deploy.
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	}
}
