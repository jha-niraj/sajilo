{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sajilo",
	// worker.ts wraps OpenNext's handler so sign-out is answered before the Next bundle loads.
	"main": "worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": true,

	// Smart placement. Pinning to aws:ap-southeast-1 (next to Neon) was measured on 2026-10-16 and made
	// every response ~3x slower from Nepal (page first byte 64-131 ms -> 347-503 ms): every request,
	// even the static login page, was forwarded to Singapore (Cf-Placement: remote-SIN), and Sajilo's
	// pages make only a few queries. Re-measure with `pnpm bench:nav` before pinning again.
	"placement": { "mode": "smart" },

	// The nightly Recharge close at 00:05 Nepal time (18:20 UTC): worker.ts `scheduled` -> /api/cron/recharge.
	"triggers": { "crons": ["20 18 * * *"] },

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Only what is not in .env.production. Everything in .env.production (DATABASE_URL, auth, Sarvam,
	// OpenAI, Resend, the site URLs, R2 keys) goes up as Worker secrets with `pnpm deploy`
	// (--secrets-file) or `pnpm secrets`. A key must not be in both places.
	"vars": {
		"ADMIN_APP_URL": "https://admin.sajilo.example.com"
	},

	// Same as Gurukul and the Cloudflare dashboard: logs and traces kept, every request sampled.
	// Leaving this out would switch them off again on the next deploy.
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	}
}
