{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sajilo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"minify": true,

	// Smart placement: Cloudflare moves the Worker toward Neon (ap-southeast-1) once it has seen
	// enough traffic. With one user it may stay near Kathmandu, which is fine for these few-query
	// pages. Switch to { "region": "aws:ap-southeast-1" } to pin it if pages ever feel slow.
	"placement": { "mode": "smart" },

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Only what is not in .env.production. Everything in .env.production (DATABASE_URL, auth, Sarvam,
	// OpenAI, Resend, the site URLs, R2 keys) goes up as Worker secrets with `pnpm deploy`
	// (--secrets-file) or `pnpm secrets`. A key must not be in both places.
	"vars": {
		"ADMIN_APP_URL": "https://admin.sajilo.example.com"
	},

	// Same as Gurukul and the Cloudflare dashboard: logs and traces kept, every request sampled.
	// Leaving this out would switch them off again on the next deploy.
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	}
}
