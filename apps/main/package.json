{
	"name": "main",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3100",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --max-warnings 0",
		"check-types": "next typegen && tsc --noEmit",
		"deploy:build": "opennextjs-cloudflare build && node scripts/strip-bundled-env.mjs",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"deploy": "pnpm deploy:build && wrangler deploy --secrets-file .env.production",
		"deploy:nosecrets": "pnpm deploy:build && wrangler deploy",
		"secrets": "wrangler secret bulk .env.production",
		"images": "node --env-file=.env scripts/generate-images.mjs",
		"icon": "node --env-file=.env scripts/generate-icon.mjs",
		"icon:build": "node scripts/build-icons.mjs",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@ai-sdk/openai": "^1.3.22",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@opennextjs/cloudflare": "^1.20.11",
		"@repo/ai": "workspace:*",
		"@repo/auth": "workspace:*",
		"@repo/calendar": "workspace:*",
		"@repo/core": "workspace:*",
		"@repo/db": "workspace:*",
		"@repo/errors": "workspace:*",
		"@repo/pdf": "workspace:*",
		"@repo/sarvamai": "workspace:*",
		"@repo/storage": "workspace:*",
		"@repo/ui": "workspace:*",
		"@serwist/next": "^9.5.13",
		"@tailwindcss/postcss": "^4.1.18",
		"ai": "^4.3.16",
		"dexie": "^4.4.6",
		"dexie-react-hooks": "^4.2.0",
		"framer-motion": "^12.23.26",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.562.0",
		"next": "~16.3.8",
		"postcss": "^8.5.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"resend": "^4.5.1",
		"server-only": "^0.0.1",
		"serwist": "^9.5.13",
		"sonner": "^2.0.7",
		"tailwindcss": "^4.1.18",
		"zod": "^4.3.2",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^22.15.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.1",
		"sharp": "0.34.5",
		"typescript": "5.9.2",
		"vitest": "^5.0.4",
		"wrangler": "^4.151.0"
	}
}
