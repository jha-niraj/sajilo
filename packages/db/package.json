{
	"name": "@repo/db",
	"version": "1.0.0",
	"description": "Shared Drizzle ORM database client for the monorepo",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./schema": "./src/schema/index.ts",
		"./request-timing": "./src/request-timing.ts"
	},
	"scripts": {
		"db:generate": "dotenv -e ../../apps/main/.env -- drizzle-kit generate",
		"db:push": "dotenv -e ../../apps/main/.env -- drizzle-kit push",
		"db:migrate": "dotenv -e ../../apps/main/.env -- drizzle-kit migrate",
		"db:studio": "dotenv -e ../../apps/main/.env -- drizzle-kit studio",
		"db:seed": "dotenv -e ../../apps/main/.env -- tsx src/seed.ts",
		"db:seed-demo": "dotenv -e ../../apps/main/.env -- tsx src/seed-demo.ts",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"@neondatabase/serverless": "^1.2.0",
		"@repo/errors": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.3",
		"better-auth": "^1.7.7",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.19.3",
		"typescript": "5.9.2",
		"@repo/typescript-config": "workspace:*",
		"postgres": "^3.4.7"
	}
}
